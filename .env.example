# Copia este archivo como .env y llena tus propios valores.
# NUNCA subas el archivo .env real a GitHub (agrégalo a .gitignore).

DATABASE_URL=sqlite:///./panaderia.db
# Para usar PostgreSQL en vez de SQLite, comenta la línea de arriba y usa esta:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/panaderia
SECRET_KEY=cambia_esto_por_una_clave_generada
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Para generar una SECRET_KEY segura, corre en tu terminal:
# python -c "import secrets; print(secrets.token_hex(32))"
